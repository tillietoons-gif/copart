# Copart Automation Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Copart Account Credentials
COPART_EMAIL=levontecwilliams@gmail.com
COPART_PASSWORD=Lw122403$

# Browser Settings
HEADLESS=true
BROWSER_CHANNEL=chromium

# Paths
DOWNLOAD_DIR=./downloads
DATABASE_PATH=./data/copart.db
STORAGE_STATE_PATH=./data/auth_state.json

# Timeouts (seconds)
NAVIGATION_TIMEOUT=60000
ACTION_TIMEOUT=10000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MULTIPLIER=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/copart_automation.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
